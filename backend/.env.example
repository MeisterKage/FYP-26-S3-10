# Copy to .env and fill in.  .env is gitignored -- NEVER commit real credentials.

FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# Supabase -> Project Settings -> Database -> Connection string (URI).
# Use the *session pooler* URI for local dev. Note the +psycopg driver suffix.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# JWT signing for our own sessions (Flask issues these, not Supabase).
JWT_SECRET=change-me-too
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=14

# Password reset link lifetime (PDD Figure 5.11: "expires after a fixed window")
RESET_TOKEN_TTL_MINUTES=30

CORS_ORIGINS=http://localhost:5173

# Rate-limit counter storage. "memory://" is fine for development and a
# single-process demo; it resets on restart and is not shared across workers.
# Use redis://localhost:6379 if you deploy with more than one worker.
RATELIMIT_STORAGE_URI=memory://
